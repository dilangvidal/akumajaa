---
import { site } from '../config/site';

const services = [
  {
    eyebrow: 'Servicio de atención',
    title: 'Agentes que atienden por ti',
    body: 'Un equipo capacitado en tu producto y tu tono se hace cargo de las conversaciones.',
    points: [
      'Agentes formados en tu catálogo, políticas y tono de marca',
      'Cobertura en los horarios que acordemos, incluidos fines de semana',
      'Protocolos y respuestas tipificadas para resolver sin improvisar',
      'Escalamiento a tu equipo interno cuando el caso lo requiere',
    ],
  },
  {
    eyebrow: 'Servicio técnico',
    title: 'Implementación de tu plataforma',
    body: 'Montamos la infraestructura que unifica los canales y la dejamos funcionando.',
    points: [
      'Conexión de WhatsApp, redes sociales, chat web y correo',
      'Automatizaciones, etiquetas y asignación por reglas',
      'Integración con tu CRM y las herramientas que ya usas',
      'Capacitación del equipo y acompañamiento tras el arranque',
    ],
  },
];
---

<section id="servicios" class="border-b border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        Dos formas de trabajar juntos
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        Puedes tomar uno o los dos. La mayoría empieza por la implementación y luego
        nos delega la operación.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {
        services.map(service => (
          <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-8">
            <p class="text-sm font-semibold uppercase tracking-wider text-brand-700">
              {service.eyebrow}
            </p>
            <h3 class="mt-3 text-2xl font-bold tracking-tight">{service.title}</h3>
            <p class="mt-3 leading-relaxed text-slate-600">{service.body}</p>

            <ul class="mt-6 space-y-3 border-t border-slate-200 pt-6">
              {service.points.map(point => (
                <li class="flex gap-3">
                  <svg
                    class="mt-0.5 size-5 shrink-0 text-brand-700"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.25 7.3a1 1 0 0 1-1.42 0l-3.75-3.77a1 1 0 0 1 1.418-1.41l3.04 3.057 6.54-6.585a1 1 0 0 1 1.416-.006Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span class="text-slate-700">{point}</span>
                </li>
              ))}
            </ul>

            <a
              href={site.contact.bookingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 inline-flex w-fit items-center gap-1.5 text-sm font-semibold text-brand-700 transition-colors hover:text-brand-900"
            >
              Hablemos de esto
              <span aria-hidden="true">&rarr;</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
