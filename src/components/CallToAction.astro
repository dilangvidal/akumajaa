---
import { site } from '../config/site';
---

<section id="contacto" class="bg-white">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <div class="rounded-3xl border border-slate-200 bg-slate-50 px-6 py-14 text-center sm:px-14">
      <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        Agendemos 30 minutos
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-slate-600">
        Revisamos tus canales y volúmenes actuales, y te decimos con franqueza si
        podemos ayudarte y cómo. Sin costo y sin compromiso.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href={site.contact.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg bg-brand-700 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-brand-800"
        >
          Reservar en el calendario
        </a>
        <a
          href={`mailto:${site.contact.email}`}
          class="rounded-lg border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-700 transition-colors hover:border-slate-400 hover:text-slate-900"
        >
          Escribir un correo
        </a>
      </div>
    </div>
  </div>
</section>
