---
import { channels } from '../config/site';
---

<section id="canales" class="border-b border-slate-200 bg-white">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        Todos los canales, una sola bandeja
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        Tu cliente escribe por donde le quede cómodo. Tu equipo lo atiende desde un
        solo lugar, con todo el historial a la vista.
      </p>
    </div>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        channels.map(channel => (
          <li class="flex items-start gap-4 rounded-xl border border-slate-200 p-5">
            <span
              class="grid size-10 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-700"
              aria-hidden="true"
            >
              <svg class="size-5" viewBox="0 0 20 20" fill="currentColor">
                <path
                  fill-rule="evenodd"
                  d="M10 2c-4.42 0-8 3.13-8 7 0 2.2 1.16 4.15 2.98 5.44-.14.9-.5 1.9-1.2 2.86a.5.5 0 0 0 .55.78c1.9-.5 3.2-1.3 4-1.93.53.1 1.09.15 1.67.15 4.42 0 8-3.13 8-7s-3.58-7-8-7Z"
                  clip-rule="evenodd"
                />
              </svg>
            </span>
            <div>
              <h3 class="font-semibold">{channel.name}</h3>
              <p class="mt-1 text-sm text-slate-600">{channel.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
