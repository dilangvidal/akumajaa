---
import { metrics } from '../config/site';
---

<section class="border-b border-slate-200 bg-brand-900">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
      A qué nos comprometemos
    </h2>

    <dl class="mt-10 grid gap-8 sm:grid-cols-3">
      {
        metrics.map(metric => (
          <div class="border-t border-brand-700 pt-6">
            <dd class="text-4xl font-bold tracking-tight text-white">{metric.value}</dd>
            <dt class="mt-2 font-semibold text-brand-100">{metric.label}</dt>
            <p class="mt-1 text-sm text-brand-200">{metric.note}</p>
          </div>
        ))
      }
    </dl>
  </div>
</section>
