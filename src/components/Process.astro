---
import { steps } from '../config/site';
---

<section id="proceso" class="border-b border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        Cómo funciona
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        Sin sorpresas: sabes en qué etapa estás y qué sigue.
      </p>
    </div>

    <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, index) => (
          <li class="rounded-2xl border border-slate-200 bg-white p-6">
            <span
              class="grid size-9 place-items-center rounded-lg bg-brand-700 text-sm font-bold text-white"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <h3 class="mt-4 text-lg font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
