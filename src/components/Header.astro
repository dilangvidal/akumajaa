---
import { site } from '../config/site';

const links = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#canales', label: 'Canales' },
  { href: '#proceso', label: 'Proceso' },
];
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-6">
    <a href="/" class="flex items-center gap-2.5 text-lg font-semibold tracking-tight">
      <span class="grid size-8 place-items-center rounded-lg bg-brand-700 text-sm font-bold text-white">
        A
      </span>
      {site.name}
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-8 md:flex">
      {
        links.map(link => (
          <a
            href={link.href}
            class="text-sm font-medium text-slate-600 transition-colors hover:text-brand-700"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href={site.contact.bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-lg bg-brand-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-800"
    >
      Agendar llamada
    </a>
  </div>
</header>
